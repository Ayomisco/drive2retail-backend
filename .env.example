# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-with-scripts-gen_secret.py
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_URL=http://localhost:8000

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────
DATABASE_URL=postgres://d2r:d2r@localhost:5432/d2r
# 0 behind PgBouncer, 60 without
DB_CONN_MAX_AGE=0

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Frontend origins ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Drive 2 Retail <noreply@drive2retail.com>
SUPPORT_EMAIL=support@drive2retail.com

# ── Payments ──────────────────────────────────────────────────────────────
PAYMENT_ACTIVE_GATEWAY=paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Object storage (S3 / Cloudflare R2) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=d2r-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_CUSTOM_DOMAIN=

# ── Business rules (mirrored in the `setting` table at runtime) ───────────
CHECKOUT_RESERVATION_TTL_MINUTES=20
ACCOUNTS_REQUIRE_APPROVAL=True
DEFAULT_CURRENCY=NGN
DEFAULT_TAX_RATE=7.5

# ── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
